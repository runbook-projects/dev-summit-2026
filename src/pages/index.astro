---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home">
  <section class="hero">
    <div class="hero-content">
      <div class="container">
        <div class="hero-text">
          <h1>Dev Summit 2026</h1>
          <p class="hero-subtitle">A developer conference on AI-assisted engineering workflows</p>
          <div class="hero-buttons">
            <a href="#register" class="btn btn-primary">Register Now</a>
            <a href="#about" class="btn btn-secondary">Learn More</a>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-image">
      <img src="/dev-summit-2026/assets/event-image-1.png" alt="Dev Summit 2026 Hero Banner" />
    </div>
  </section>

  <section id="about" class="about">
    <div class="container">
      <h2>About the Summit</h2>
      <div class="about-grid">
        <div class="about-card">
          <h3>🤖 AI-Assisted Workflows</h3>
          <p>Explore how artificial intelligence is transforming the way developers write, test, and deploy code. Learn best practices for integrating AI tools into your engineering pipeline.</p>
        </div>
        <div class="about-card">
          <h3>🚀 Cutting-Edge Talks</h3>
          <p>Hear from industry leaders and innovators about the latest trends in AI-assisted development, machine learning operations, and intelligent code generation.</p>
        </div>
        <div class="about-card">
          <h3>🤝 Networking</h3>
          <p>Connect with fellow developers, engineers, and tech enthusiasts. Share experiences, collaborate on projects, and build lasting professional relationships.</p>
        </div>
        <div class="about-card">
          <h3>💡 Hands-On Workshops</h3>
          <p>Participate in interactive workshops and breakout sessions designed to give you practical skills and real-world experience with AI development tools.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="schedule" class="schedule">
    <div class="container">
      <h2>Event Schedule</h2>
      <div class="schedule-grid">
        <div class="schedule-day">
          <h3>Day 1: June 15, 2026</h3>
          <ul class="schedule-list">
            <li>
              <span class="time">09:00 AM</span>
              <span class="event">Registration & Breakfast</span>
            </li>
            <li>
              <span class="time">10:00 AM</span>
              <span class="event">Keynote: The Future of AI in Development</span>
            </li>
            <li>
              <span class="time">11:30 AM</span>
              <span class="event">Parallel Tracks: Workshops & Talks</span>
            </li>
            <li>
              <span class="time">12:30 PM</span>
              <span class="event">Lunch Break</span>
            </li>
            <li>
              <span class="time">01:30 PM</span>
              <span class="event">Technical Sessions</span>
            </li>
            <li>
              <span class="time">05:00 PM</span>
              <span class="event">Networking Reception</span>
            </li>
          </ul>
        </div>
        <div class="schedule-day">
          <h3>Day 2: June 16, 2026</h3>
          <ul class="schedule-list">
            <li>
              <span class="time">09:00 AM</span>
              <span class="event">Breakfast & Networking</span>
            </li>
            <li>
              <span class="time">10:00 AM</span>
              <span class="event">Panel Discussion: AI Ethics & Responsibility</span>
            </li>
            <li>
              <span class="time">11:30 AM</span>
              <span class="event">Hands-On Workshops</span>
            </li>
            <li>
              <span class="time">12:30 PM</span>
              <span class="event">Lunch Break</span>
            </li>
            <li>
              <span class="time">01:30 PM</span>
              <span class="event">Lightning Talks & Demos</span>
            </li>
            <li>
              <span class="time">04:00 PM</span>
              <span class="event">Closing Remarks & Raffle</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="venue" class="venue">
    <div class="container">
      <h2>Venue Information</h2>
      <div class="venue-content">
        <div class="venue-details">
          <h3>Tech Convention Center</h3>
          <p><strong>Address:</strong> 123 Innovation Drive, San Francisco, CA 94105</p>
          <p><strong>Dates:</strong> June 15-16, 2026</p>
          <p><strong>Time:</strong> 9:00 AM - 5:00 PM (Both Days)</p>
          <p><strong>Capacity:</strong> 1,500+ attendees</p>
          <div class="venue-amenities">
            <h4>Amenities:</h4>
            <ul>
              <li>✓ Free WiFi throughout the venue</li>
              <li>✓ Complimentary breakfast, lunch, and refreshments</li>
              <li>✓ Accessible facilities and parking</li>
              <li>✓ On-site tech support</li>
              <li>✓ Networking lounge</li>
            </ul>
          </div>
        </div>
        <div class="venue-map">
          <div class="map-placeholder">
            <p>📍 Map Coming Soon</p>
            <p>Directions and parking information will be provided to registered attendees.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="register" class="register">
    <div class="container">
      <h2>Register for Dev Summit 2026</h2>
      <div class="register-content">
        <div class="register-info">
          <h3>Early Bird Pricing</h3>
          <div class="pricing-cards">
            <div class="price-card">
              <h4>Standard Ticket</h4>
              <p class="price">$199</p>
              <ul>
                <li>✓ 2-day access</li>
                <li>✓ All talks and workshops</li>
                <li>✓ Meals included</li>
                <li>✓ Networking events</li>
              </ul>
            </div>
            <div class="price-card featured">
              <h4>VIP Ticket</h4>
              <p class="price">$349</p>
              <ul>
                <li>✓ Everything in Standard</li>
                <li>✓ VIP lounge access</li>
                <li>✓ 1-on-1 mentor sessions</li>
                <li>✓ Premium swag bag</li>
              </ul>
            </div>
            <div class="price-card">
              <h4>Student Ticket</h4>
              <p class="price">$99</p>
              <ul>
                <li>✓ 2-day access</li>
                <li>✓ All talks and workshops</li>
                <li>✓ Meals included</li>
                <li>✓ Student networking</li>
              </ul>
            </div>
          </div>
        </div>
        <div class="register-form">
          <form>
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required />
            </div>
            <div class="form-group">
              <label for="company">Company</label>
              <input type="text" id="company" name="company" />
            </div>
            <div class="form-group">
              <label for="ticket">Ticket Type</label>
              <select id="ticket" name="ticket" required>
                <option value="">Select a ticket type</option>
                <option value="standard">Standard Ticket - $199</option>
                <option value="vip">VIP Ticket - $349</option>
                <option value="student">Student Ticket - $99</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary btn-large">Complete Registration</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    padding: 4rem 0;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  }

  .hero-content {
    padding: 2rem 0;
  }

  .hero-text h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    color: #0066cc;
    line-height: 1.2;
  }

  .hero-subtitle {
    font-size: 1.3rem;
    color: #555;
    margin-bottom: 2rem;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.75rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    display: inline-block;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background-color: #0066cc;
    color: white;
  }

  .btn-primary:hover {
    background-color: #0052a3;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: transparent;
    color: #0066cc;
    border: 2px solid #0066cc;
  }

  .btn-secondary:hover {
    background-color: #0066cc;
    color: white;
  }

  .btn-large {
    padding: 1rem 2.5rem;
    font-size: 1.1rem;
    width: 100%;
  }

  .hero-image {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .about {
    padding: 4rem 0;
    background-color: #f8f9fa;
  }

  .about h2,
  .schedule h2,
  .venue h2,
  .register h2 {
    font-size: 2.5rem;
    margin-bottom: 3rem;
    text-align: center;
    color: #1a1a1a;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .about-card {
    background-color: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .about-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .about-card h3 {
    margin-bottom: 1rem;
    color: #0066cc;
    font-size: 1.3rem;
  }

  .about-card p {
    color: #555;
    line-height: 1.8;
  }

  .schedule {
    padding: 4rem 0;
  }

  .schedule-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .schedule-day {
    background-color: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    border-left: 4px solid #0066cc;
  }

  .schedule-day h3 {
    margin-bottom: 1.5rem;
    color: #0066cc;
    font-size: 1.3rem;
  }

  .schedule-list {
    list-style: none;
  }

  .schedule-list li {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e9ecef;
  }

  .schedule-list li:last-child {
    border-bottom: none;
  }

  .time {
    font-weight: 600;
    color: #0066cc;
    min-width: 80px;
  }

  .event {
    color: #555;
  }

  .venue {
    padding: 4rem 0;
    background-color: #f8f9fa;
  }

  .venue-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  .venue-details h3 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #0066cc;
  }

  .venue-details p {
    margin-bottom: 1rem;
    color: #555;
    line-height: 1.8;
  }

  .venue-amenities {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #e9ecef;
  }

  .venue-amenities h4 {
    margin-bottom: 1rem;
    color: #1a1a1a;
  }

  .venue-amenities ul {
    list-style: none;
  }

  .venue-amenities li {
    margin-bottom: 0.5rem;
    color: #555;
  }

  .map-placeholder {
    background-color: #e9ecef;
    padding: 3rem;
    border-radius: 8px;
    text-align: center;
    color: #555;
  }

  .map-placeholder p {
    margin-bottom: 1rem;
  }

  .register {
    padding: 4rem 0;
  }

  .register-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .pricing-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .price-card {
    background-color: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
    border: 2px solid #e9ecef;
    transition: all 0.3s ease;
  }

  .price-card.featured {
    background-color: #0066cc;
    color: white;
    border-color: #0066cc;
    transform: scale(1.05);
  }

  .price-card h4 {
    margin-bottom: 1rem;
    font-size: 1.2rem;
  }

  .price {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #0066cc;
  }

  .price-card.featured .price {
    color: white;
  }

  .price-card ul {
    list-style: none;
  }

  .price-card li {
    margin-bottom: 0.75rem;
    font-size: 0.95rem;
  }

  .register-form {
    background-color: #f8f9fa;
    padding: 2rem;
    border-radius: 8px;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #1a1a1a;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
    font-family: inherit;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: #0066cc;
    box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
  }

  @media (max-width: 768px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 2rem 0;
    }

    .hero-text h1 {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-buttons {
      flex-direction: column;
    }

    .btn {
      width: 100%;
      text-align: center;
    }

    .about h2,
    .schedule h2,
    .venue h2,
    .register h2 {
      font-size: 2rem;
    }

    .venue-content,
    .register-content {
      grid-template-columns: 1fr;
    }

    .price-card.featured {
      transform: scale(1);
    }
  }
</style>
